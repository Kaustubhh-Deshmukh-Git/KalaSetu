# ==============================================================================
# KalaSetu Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env in the server/ root or project root and replace placeholders.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb://localhost:27017/kalasetu or MongoDB Atlas URI)
# Note: If omitted or unreachable in dev, server automatically falls back to in-memory MongoDB
MONGO_URI=mongodb://localhost:27017/kalasetu

# Redis connection URL (e.g., redis://localhost:6379 or Upstash Redis URL)
# Note: If omitted or unreachable in dev, server automatically falls back to in-memory Redis
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing artisan JWT tokens
JWT_SECRET=kalasetu_jwt_secret_change_in_production_key_2026
JWT_EXPIRES_IN=30d

# 32-byte encryption key for encrypting stored marketplace credentials at rest
CREDENTIAL_ENCRYPTION_KEY=kalasetu_credential_key_32bytes_dev_only!

# OTP Authentication Settings
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# ------------------------------------------------------------------------------
# 4. Cloudinary (Media Storage & AI Background Removal Primary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------------------
# 5. Multilingual NLP & AI Cataloging
# ------------------------------------------------------------------------------
# Google Gemini API Key (Primary NLP provider for product title/description generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Fallback NLP provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 6. Speech-to-Text Providers
# ------------------------------------------------------------------------------
# Google Speech-to-Text API Key (Primary transcription provider)
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# OpenAI Whisper API Key (Fallback transcription provider)
OPENAI_API_KEY=your_openai_whisper_api_key_here

# ------------------------------------------------------------------------------
# 7. Vision & Background Removal Fallbacks
# ------------------------------------------------------------------------------
# Remove.bg API Key (Tier 2 fallback for background removal)
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Self-Hosted Rembg URL (Tier 3 deterministic local fallback)
REMBG_SERVICE_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 8. Dynamic Pricing Microservice
# ------------------------------------------------------------------------------
# FastAPI Python Pricing Microservice endpoint
PRICING_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 9. Marketplace & Storefront Configuration
# ------------------------------------------------------------------------------
# Government e-Marketplace (GeM) Sandbox/Production API Key
GEM_API_KEY=

# Public Artisan Web Storefront Base URL (for buyer QR codes and links)
STOREFRONT_BASE_URL=https://kalasetu.app
