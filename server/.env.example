# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# If MONGO_URI is omitted or cannot connect, server automatically falls back to in-memory MongoDB
MONGO_URI=

# Redis
# If REDIS_URL is omitted or cannot connect, server automatically falls back to in-memory Redis
REDIS_URL=

# JWT Secrets
JWT_SECRET=kalasetu_jwt_secret_development_key_change_in_production_2026
JWT_EXPIRES_IN=30d

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# Security
CREDENTIAL_ENCRYPTION_KEY=kalasetu_credential_key_32bytes_dev_only!
